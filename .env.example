# Copy to server/.env and replace these values.
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/interviewready_ai
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:5173
# Optional. If omitted, JD analysis uses clearly labeled keyword extraction.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

